source "https://rubygems.org"

# Hello! This is where you manage which Jekyll version is used to run.
# When you want to use a different version, change it below, save the
# file and run `bundle install`. Run Jekyll with `bundle exec`, like so:
#
#     bundle exec jekyll serve
#
# This will help ensure the proper Jekyll version is running. https://pages.github.com/versions/
# 
# For local development and CI: use Jekyll directly.
# The GitHub Actions deploy workflow builds from this Gemfile, so we don't rely on GitHub Pages' built-in Jekyll.
gem "jekyll", "~> 4.4"

# This is the default theme for new Jekyll sites. You may change this to anything you like.
gem "minima", "~> 2.5"

# If you have any plugins, put them here!
group :jekyll_plugins do
  gem "jekyll-feed", "~> 0.6"
  gem "jekyll-email-protect"
  gem "jekyll-multiple-languages-plugin", "~> 1.7.0"
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
end

# kramdown v2 ships without the gfm parser by default.
# This parser enables GitHub Flavored Markdown support in kramdown.
gem "kramdown-parser-gfm"

# webrick is required for Ruby 3.0+ (including Ruby 4.0) as it's no longer included by default.
gem "webrick", "~> 1.8"

# Windows-specific dependencies (safe to keep; only apply on Windows)
install_if -> { RUBY_PLATFORM =~ %r!mingw|mswin|java! } do
  # Windows does not include zoneinfo files.
  gem "tzinfo", "~> 1.2"
  gem "tzinfo-data"
end

# Performance-booster for watching directories on Windows
gem "wdm", "~> 0.1.0", :install_if => Gem.win_platform?
